<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Triki.uss" />
    <ui:VisualElement name="menu-screen" class="screen">
        <ui:VisualElement name="main-panel" class="panel">
            <ui:Label text="TRIKI" class="title" />
            <ui:Label text="Tres en línea con movimiento" class="subtitle" />
            <ui:Button name="play-button" text="Iniciar partida" class="menu-button menu-button--primary" />
            <ui:Button name="history-button" text="Histórico de partidas" class="menu-button" />
            <ui:Button name="sound-button" text="Sonido: Sí" class="menu-button" />
            <ui:Button name="quit-button" text="Salir" class="menu-button" />
        </ui:VisualElement>

        <ui:VisualElement name="setup-panel" class="panel hidden">
            <ui:Label text="Nueva partida" class="panel-title" />
            <ui:Label text="Modo" class="option-label" />
            <ui:VisualElement class="segmented">
                <ui:Button name="mode-ai" text="Contra la IA" class="segment" />
                <ui:Button name="mode-local" text="Dos jugadores" class="segment" />
            </ui:VisualElement>
            <ui:VisualElement name="ai-options">
                <ui:Label text="Dificultad" class="option-label" />
                <ui:VisualElement class="segmented">
                    <ui:Button name="difficulty-easy" text="Fácil" class="segment" />
                    <ui:Button name="difficulty-normal" text="Normal" class="segment" />
                    <ui:Button name="difficulty-hard" text="Difícil" class="segment" />
                </ui:VisualElement>
                <ui:Label text="Tu color" class="option-label" />
                <ui:VisualElement class="segmented">
                    <ui:Button name="color-one" text="Rojo (empiezas)" class="segment" />
                    <ui:Button name="color-two" text="Azul" class="segment" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="start-button" text="Jugar" class="menu-button menu-button--primary setup-start" />
            <ui:Button name="setup-back-button" text="Volver" class="menu-button" />
        </ui:VisualElement>

        <ui:VisualElement name="history-panel" class="panel hidden">
            <ui:Label text="Histórico de partidas" class="panel-title" />
            <ui:VisualElement class="stat-total">
                <ui:Label text="Partidas jugadas" class="stat-total__name" />
                <ui:Label name="games-played" text="0" class="stat-total__value" />
            </ui:VisualElement>
            <ui:VisualElement class="stat-total">
                <ui:Label text="Empates" class="stat-total__name" />
                <ui:Label name="draws" text="0" class="stat-total__value" />
            </ui:VisualElement>
            <ui:VisualElement class="stats-table">
                <ui:VisualElement class="stats-table__row stats-table__header">
                    <ui:Label text="Color" class="cell cell--name" />
                    <ui:Label text="Victorias" class="cell" />
                    <ui:Label text="Derrotas" class="cell" />
                </ui:VisualElement>
                <ui:VisualElement class="stats-table__row">
                    <ui:Label name="player-one-name" text="Rojo" class="cell cell--name player-one" />
                    <ui:Label name="player-one-wins" text="0" class="cell" />
                    <ui:Label name="player-one-losses" text="0" class="cell" />
                </ui:VisualElement>
                <ui:VisualElement class="stats-table__row">
                    <ui:Label name="player-two-name" text="Azul" class="cell cell--name player-two" />
                    <ui:Label name="player-two-wins" text="0" class="cell" />
                    <ui:Label name="player-two-losses" text="0" class="cell" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="back-button" text="Volver" class="menu-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
