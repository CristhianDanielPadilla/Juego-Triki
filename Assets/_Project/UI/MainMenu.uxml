<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="ColorStatsTable" src="ColorStatsTable.uxml" />
    <Style src="Triki.uss" />
    <ui:VisualElement name="menu-screen" class="screen">
        <ui:VisualElement name="main-panel" class="panel">
            <ui:Label text="TRIKI" class="title" />
            <ui:Label text="Tres en línea con movimiento" class="subtitle" />
            <ui:Button name="play-button" text="Iniciar partida" class="menu-button menu-button--primary" />
            <ui:Button name="history-button" text="Histórico de partidas" class="menu-button" />
            <ui:Button name="sound-button" text="Sonido: Sí" class="menu-button" />
            <ui:Button name="quit-button" text="Salir" class="menu-button" />
        </ui:VisualElement>

        <ui:VisualElement name="setup-panel" class="panel hidden">
            <ui:Label text="Nueva partida" class="panel-title" />
            <ui:Label text="Modo" class="option-label" />
            <ui:VisualElement class="segmented">
                <ui:Button name="mode-ai" text="Contra la IA" class="segment" />
                <ui:Button name="mode-local" text="Dos jugadores" class="segment" />
            </ui:VisualElement>
            <ui:VisualElement name="ai-options">
                <ui:Label text="Dificultad" class="option-label" />
                <ui:VisualElement class="segmented">
                    <ui:Button name="difficulty-easy" text="Fácil" class="segment" />
                    <ui:Button name="difficulty-normal" text="Normal" class="segment" />
                    <ui:Button name="difficulty-hard" text="Difícil" class="segment" />
                </ui:VisualElement>
                <ui:Label text="Tu color" class="option-label" />
                <ui:VisualElement class="segmented">
                    <ui:Button name="color-one" text="Rojo (empiezas)" class="segment" />
                    <ui:Button name="color-two" text="Azul" class="segment" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="start-button" text="Jugar" class="menu-button menu-button--primary setup-start" />
            <ui:Button name="setup-back-button" text="Volver" class="menu-button" />
        </ui:VisualElement>

        <ui:VisualElement name="history-panel" class="panel panel--wide hidden">
            <ui:Label text="Histórico de partidas" class="panel-title" />
            <ui:VisualElement class="segmented history-tabs">
                <ui:Button name="tab-general" text="General" class="segment" />
                <ui:Button name="tab-ai" text="Contra la IA" class="segment" />
                <ui:Button name="tab-local" text="Dos jugadores" class="segment" />
            </ui:VisualElement>

            <!-- General: todas las partidas, sin importar el modo. -->
            <ui:Instance template="ColorStatsTable" name="history-general" />

            <!-- Contra la IA: tus resultados por dificultad. -->
            <ui:VisualElement name="history-ai">
                <ui:VisualElement class="stat-total">
                    <ui:Label text="Partidas jugadas" class="stat-total__name" />
                    <ui:Label name="ai-games" text="0" class="stat-total__value" />
                </ui:VisualElement>
                <!-- Cabecera en dos lineas: arriba el color que llevabas, abajo el resultado. -->
                <ui:VisualElement class="stats-table ai-table">
                    <ui:VisualElement class="stats-table__row stats-table__header">
                        <ui:Label text="" class="cell cell--name" />
                        <ui:Label text="Jugando de Rojo" class="cell ai-group player-one" />
                        <ui:Label text="Jugando de Azul" class="cell ai-group player-two cell--divider" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stats-table__row stats-table__header">
                        <ui:Label text="Dificultad" class="cell cell--name" />
                        <ui:Label text="Vict." class="cell" />
                        <ui:Label text="Derr." class="cell" />
                        <ui:Label text="Emp." class="cell" />
                        <ui:Label text="Vict." class="cell cell--divider" />
                        <ui:Label text="Derr." class="cell" />
                        <ui:Label text="Emp." class="cell" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ai-easy" class="stats-table__row">
                        <ui:Label text="Fácil" class="cell cell--name" />
                        <ui:Label name="one-wins" text="0" class="cell" />
                        <ui:Label name="one-losses" text="0" class="cell" />
                        <ui:Label name="one-draws" text="0" class="cell" />
                        <ui:Label name="two-wins" text="0" class="cell cell--divider" />
                        <ui:Label name="two-losses" text="0" class="cell" />
                        <ui:Label name="two-draws" text="0" class="cell" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ai-normal" class="stats-table__row">
                        <ui:Label text="Normal" class="cell cell--name" />
                        <ui:Label name="one-wins" text="0" class="cell" />
                        <ui:Label name="one-losses" text="0" class="cell" />
                        <ui:Label name="one-draws" text="0" class="cell" />
                        <ui:Label name="two-wins" text="0" class="cell cell--divider" />
                        <ui:Label name="two-losses" text="0" class="cell" />
                        <ui:Label name="two-draws" text="0" class="cell" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ai-hard" class="stats-table__row">
                        <ui:Label text="Difícil" class="cell cell--name" />
                        <ui:Label name="one-wins" text="0" class="cell" />
                        <ui:Label name="one-losses" text="0" class="cell" />
                        <ui:Label name="one-draws" text="0" class="cell" />
                        <ui:Label name="two-wins" text="0" class="cell cell--divider" />
                        <ui:Label name="two-losses" text="0" class="cell" />
                        <ui:Label name="two-draws" text="0" class="cell" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <!-- Solo se ve si hay partidas de v0.3.0 o anterior, que no guardaban el color. -->
                <ui:Label name="ai-colorless" text="" class="table-note hidden" />
            </ui:VisualElement>

            <!-- Dos jugadores: por color. -->
            <ui:Instance template="ColorStatsTable" name="history-local" />

            <!-- Borra solo el registro de la pestaña visible, tras confirmar. -->
            <ui:Button name="delete-history-button" text="Eliminar registro" class="menu-button menu-button--danger-outline history-delete" />
            <ui:Button name="back-button" text="Volver" class="menu-button" />
        </ui:VisualElement>

        <!-- Confirmación modal. Cubre toda la pantalla para que no se pueda tocar lo de detrás. -->
        <ui:VisualElement name="confirm-overlay" class="overlay hidden">
            <ui:VisualElement name="confirm-dialog" class="panel dialog">
                <ui:Label name="confirm-title" text="¿Eliminar registro?" class="panel-title" />
                <ui:Label name="confirm-message" text="" class="dialog__message" />
                <ui:VisualElement class="dialog__actions">
                    <ui:Button name="confirm-cancel" text="Cancelar" class="menu-button dialog__button" />
                    <ui:Button name="confirm-accept" text="Eliminar" class="menu-button menu-button--danger dialog__button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
